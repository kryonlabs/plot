App :: #import "kryon/app";
DashboardExample :: #import "dashboard_charts";
#import "kryon/geometry"
#import "kryon/session"

Frame :: (frame: App.Frame) {
    session := Session.{.slot = frame.slot, .epoch = frame.epoch}
    DashboardExample.Draw(session, frame.viewport)
}

main :: () -> s32 { return App.Run(App.Window.{.title = "plot"}, Frame) }
