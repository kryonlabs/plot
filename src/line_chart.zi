using UI :: #import "kryon/Kryon";
using PlotWidget :: #import "PlotWidget";

ChartRange :: struct {
    low: float32
    high: float32
    min_value: float32
    max_value: float32
}

LineChartProps :: struct {
    key: u64
    bounds: Rectangle
    semantic_label: string
    line_color: Color
    grid_color: Color
    // The earlier series in LineChartCompare, such as last week.
    compare_color: Color
}

#program_export
ChartRangeFor :: (values: []float32) -> ChartRange {
    result: ChartRange
    if values.count == 0 { return result }
    result.low = values[0]
    result.high = values[0]
    index: s32 = 1
    while index < cast(s32)values.count {
        if values[index] < result.low { result.low = values[index] }
        if values[index] > result.high { result.high = values[index] }
        index += 1
    }
    spread: float32 = result.high - result.low
    if spread < 1.0 { spread = 1.0 }
    padding: float32 = spread * 0.10
    result.min_value = result.low - padding
    result.max_value = result.high + padding
    return result
}

// One range that fits two series, for LineChartCompare.
#program_export
ChartRangeForBoth :: (values: []float32, previous: []float32) -> ChartRange {
    if previous.count == 0 { return ChartRangeFor(values) }
    if values.count == 0 { return ChartRangeFor(previous) }
    first: ChartRange = ChartRangeFor(values)
    second: ChartRange = ChartRangeFor(previous)
    both: [2]float32
    both[0] = first.low
    both[1] = first.high
    if second.low < both[0] { both[0] = second.low }
    if second.high > both[1] { both[1] = second.high }
    return ChartRangeFor(both[:])
}

// The card and its five horizontal grid lines; false when nothing fits.
LineChartFrame :: (session: Session, props: LineChartProps,
    chart_range: ChartRange) -> bool {
    background: PlotProps
    background.key = props.key
    background.mode = cast(PlotMode)0
    background.bounds = props.bounds
    background.semantic_label = props.semantic_label
    empty: [1]float32
    Plot(session, background, empty[0:0])
    if chart_range.max_value - chart_range.min_value <= 0.0 { return false }
    grid_index: s32 = 0
    while grid_index < 5 {
        fraction: float32 = cast(float32)grid_index / 4.0
        y: float32 = props.bounds.y + props.bounds.height * fraction
        PaintLine(session, -1,
            Rectangle.{props.bounds.x, y, props.bounds.width, 0.0},
            props.grid_color)
        grid_index += 1
    }
    return true
}

#program_export
LineChart :: (session: Session, props: LineChartProps,
    values: []float32, chart_range: ChartRange) {
    if !LineChartFrame(session, props, chart_range) || values.count == 0 { return }
    LineChartSeries(session, props.bounds, values, chart_range, props.line_color)
}

// Two series on one scale across the same width, such as this week over
// last week: previous in compare_color, then values in line_color on top.
#program_export
LineChartCompare :: (session: Session, props: LineChartProps,
    values: []float32, previous: []float32, chart_range: ChartRange) {
    if !LineChartFrame(session, props, chart_range) { return }
    if previous.count > 0 {
        LineChartSeries(session, props.bounds, previous, chart_range, props.compare_color)
    }
    if values.count > 0 {
        LineChartSeries(session, props.bounds, values, chart_range, props.line_color)
    }
}

// One series as a two-pixel line with a marker at its last value.
LineChartSeries :: (session: Session, bounds: Rectangle, values: []float32,
    chart_range: ChartRange, color: Color) {
    span: float32 = chart_range.max_value - chart_range.min_value
    if values.count == 1 {
        y: float32 = bounds.y + bounds.height *
            (chart_range.max_value - values[0]) / span
        PaintLine(session, -1,
            Rectangle.{bounds.x, y, bounds.width, 0.0}, color)
    } else {
        index: s32 = 1
        while index < cast(s32)values.count {
            x0: float32 = bounds.x + bounds.width *
                cast(float32)(index - 1) / cast(float32)(values.count - 1)
            x1: float32 = bounds.x + bounds.width *
                cast(float32)index / cast(float32)(values.count - 1)
            y0: float32 = bounds.y + bounds.height *
                (chart_range.max_value - values[index - 1]) / span
            y1: float32 = bounds.y + bounds.height *
                (chart_range.max_value - values[index]) / span
            PaintLine(session, -1, Rectangle.{x0, y0, x1 - x0, y1 - y0}, color)
            PaintLine(session, -1, Rectangle.{x0, y0 + 1.0, x1 - x0, y1 - y0}, color)
            index += 1
        }
    }
    last_y: float32 = bounds.y + bounds.height *
        (chart_range.max_value - values[values.count - 1]) / span
    PaintRoundedFill(session, -1,
        Rectangle.{bounds.x + bounds.width - 4.0, last_y - 4.0, 8.0, 8.0},
        4.0, 12, color)
}
