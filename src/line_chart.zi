#import "kryon/drawing_props"
#import "kryon/geometry"
#import "kryon/paint_queue"
#import "kryon/session"
Motion :: #import "kryon/motion";
Theme :: #import "kryon/theme";
using PlotWidget :: #import "PlotWidget";

ChartRange :: struct {
    low: float32
    high: float32
    min_value: float32
    max_value: float32
}

LineChartProps :: struct {
    key: u64
    bounds: Rectangle
    semantic_label: string
    line_color: Color
    grid_color: Color
    // The earlier series in LineChartCompare, such as last week.
    compare_color: Color
}

// Keep one state and 3 floats of workspace per supported point for each chart.
// Set workspace once before the first draw. The other fields belong to Plot.
AnimatedLineChartState :: struct {
    workspace: []float32
    count: s64
    phase: Motion.TweenState
}

#program_export
ChartRangeFor :: (values: []float32) -> ChartRange {
    result: ChartRange
    if values.count == 0 { return result }
    result.low = values[0]
    result.high = values[0]
    index: s32 = 1
    while index < cast(s32)values.count {
        if values[index] < result.low { result.low = values[index] }
        if values[index] > result.high { result.high = values[index] }
        index += 1
    }
    spread: float32 = result.high - result.low
    if spread < 1.0 { spread = 1.0 }
    padding: float32 = spread * 0.10
    result.min_value = result.low - padding
    result.max_value = result.high + padding
    return result
}

// One range that fits two series, for LineChartCompare.
#program_export
ChartRangeForBoth :: (values: []float32, previous: []float32) -> ChartRange {
    if previous.count == 0 { return ChartRangeFor(values) }
    if values.count == 0 { return ChartRangeFor(previous) }
    first: ChartRange = ChartRangeFor(values)
    second: ChartRange = ChartRangeFor(previous)
    both: [2]float32
    both[0] = first.low
    both[1] = first.high
    if second.low < both[0] { both[0] = second.low }
    if second.high > both[1] { both[1] = second.high }
    return ChartRangeFor(both[:])
}

// The card and its five horizontal grid lines; false when nothing fits.
LineChartFrame :: (session: Session, props: LineChartProps,
    chart_range: ChartRange) -> bool {
    background: PlotProps
    background.key = props.key
    background.mode = cast(PlotMode)0
    background.bounds = props.bounds
    background.semantic_label = props.semantic_label
    empty: [1]float32
    Plot(session, background, empty[0:0])
    if chart_range.max_value - chart_range.min_value <= 0.0 { return false }
    grid_index: s32 = 0
    while grid_index < 5 {
        fraction: float32 = cast(float32)grid_index / 4.0
        y: float32 = props.bounds.y + props.bounds.height * fraction
        PaintLine(session, -1,
            Rectangle.{props.bounds.x, y, props.bounds.width, 0.0},
            props.grid_color)
        grid_index += 1
    }
    return true
}

#program_export
LineChart :: (session: Session, props: LineChartProps,
    values: []float32, chart_range: ChartRange) {
    empty: []float32
    LineChartCompare(session, props, values, empty, chart_range)
}

// Two series on one scale across the same width, such as this week over
// last week: previous in compare_color, then values in line_color on top.
#program_export
LineChartCompare :: (session: Session, props: LineChartProps,
    values: []float32, previous: []float32, chart_range: ChartRange) {
    if !LineChartFrame(session, props, chart_range) { return }
    if previous.count > 0 {
        LineChartSeries(session, props.bounds, previous, chart_range, props.compare_color)
    }
    if values.count > 0 {
        LineChartSeries(session, props.bounds, values, chart_range, props.line_color)
    }
}

// Draw on the supplied scale and return true while another frame is needed.
// Supply monotonic seconds. Input is borrowed for this call only.
#program_export
AnimatedLineChart :: (session: Session, props: LineChartProps,
    values: []float32, chart_range: ChartRange, state: *AnimatedLineChartState,
    now: float64, duration: float64 = 0.25, reduced_motion: bool = false,
    easing: Motion.Easing = .EaseOut) -> bool {
    sample := SampleLineChart(state, values, now, duration, reduced_motion, easing)
    LineChart(session, props, sample.values, chart_range)
    return sample.active
}

#scope_file

LineChartSample :: struct {
    values: []float32
    active: bool
}

SampleLineChart :: (state: *AnimatedLineChartState, values: []float32,
    now: float64, duration: float64, reduced_motion: bool,
    easing: Motion.Easing) -> LineChartSample {
    settled := LineChartSample.{values, false}
    if state == null { return settled }
    capacity := state.workspace.count / 3
    if values.count == 0 || values.count > capacity {
        state.count = 0
        return settled
    }

    source := state.workspace[0:capacity]
    target := state.workspace[capacity:2 * capacity]
    display := state.workspace[2 * capacity:3 * capacity]
    tokens := Theme.CurrentTheme().motion
    seconds := duration * cast(float64)tokens.multiplier
    linear: Motion.Timing
    if state.count == 0 || reduced_motion || tokens.reduced_motion ||
        !(seconds > 0.0 && seconds <= 1.7976931348623157e308) {
        unused Motion.TweenTo(*state.phase, 1.0, now, seconds, linear, true)
        RememberLineTarget(state, target, values)
        return settled
    }

    old_count := state.count
    changed := values.count != old_count
    if !changed {
        for index: 0..old_count-1 {
            if values[index] != target[index] {
                changed = true
                break
            }
        }
    }

    phase := Motion.TweenTo(*state.phase, 1.0, now, seconds, linear)
    if !changed && !phase.active { return settled }
    if phase.active {
        for index: 0..old_count-1 {
            display[index] = LineValueBetween(source[index], target[index], phase.value)
        }
    }
    if !changed { return LineChartSample.{display[0:old_count], true} }

    // Read the old curve before replacing its target. Sample at the new
    // points' x positions so changing length keeps a continuous starting line.
    current := target[0:old_count]
    if phase.active { current = display[0:old_count] }
    moving := false
    for index: 0..values.count-1 {
        source[index] = LineValueAt(current, index, values.count)
        if source[index] != values[index] { moving = true }
    }
    RememberLineTarget(state, target, values)
    if !moving {
        unused Motion.TweenTo(*state.phase, 1.0, now, seconds, linear, true)
        return settled
    }

    unused Motion.TweenTo(*state.phase, 0.0, now, seconds, linear, true)
    unused Motion.TweenTo(*state.phase, 1.0, now, seconds, Motion.TimingFor(easing))
    return LineChartSample.{source[0:values.count], true}
}

RememberLineTarget :: (state: *AnimatedLineChartState, target: []float32,
    values: []float32) {
    for index: 0..values.count-1 { target[index] = values[index] }
    state.count = values.count
}

LineValueAt :: (values: []float32, index: s64, count: s64) -> float32 {
    if values.count == count { return values[index] }
    last := values.count - 1
    if count == 1 || index == count - 1 { return values[last] }
    position := cast(float64)index * cast(float64)last / cast(float64)(count - 1)
    left := cast(s64)position
    if left >= last { return values[last] }
    return LineValueBetween(values[left], values[left + 1], cast(float32)(position - cast(float64)left))
}

LineValueBetween :: (from: float32, to: float32, phase: float32) -> float32 {
    if phase == 0.0 { return from }
    if phase == 1.0 { return to }
    first := cast(float64)from
    return cast(float32)(first + (cast(float64)to - first) * cast(float64)phase)
}

#scope_export

// One series as a two-pixel line with a marker at its last value.
LineChartSeries :: (session: Session, bounds: Rectangle, values: []float32,
    chart_range: ChartRange, color: Color) {
    span: float32 = chart_range.max_value - chart_range.min_value
    if values.count == 1 {
        y: float32 = bounds.y + bounds.height *
            (chart_range.max_value - values[0]) / span
        PaintLine(session, -1,
            Rectangle.{bounds.x, y, bounds.width, 0.0}, color)
    } else {
        index: s32 = 1
        while index < cast(s32)values.count {
            x0: float32 = bounds.x + bounds.width *
                cast(float32)(index - 1) / cast(float32)(values.count - 1)
            x1: float32 = bounds.x + bounds.width *
                cast(float32)index / cast(float32)(values.count - 1)
            y0: float32 = bounds.y + bounds.height *
                (chart_range.max_value - values[index - 1]) / span
            y1: float32 = bounds.y + bounds.height *
                (chart_range.max_value - values[index]) / span
            PaintLine(session, -1, Rectangle.{x0, y0, x1 - x0, y1 - y0}, color)
            PaintLine(session, -1, Rectangle.{x0, y0 + 1.0, x1 - x0, y1 - y0}, color)
            index += 1
        }
    }
    last_y: float32 = bounds.y + bounds.height *
        (chart_range.max_value - values[values.count - 1]) / span
    PaintRoundedFill(session, -1,
        Rectangle.{bounds.x + bounds.width - 4.0, last_y - 4.0, 8.0, 8.0},
        4.0, 12, color)
}
