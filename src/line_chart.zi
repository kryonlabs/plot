#import "drawing_props"
#import "geometry"
#import "paint_queue"
#import "plot_props"
#import "plot_widget"
#import "session"

using PlotMode;

ChartRange :: struct {
    low: float32
    high: float32
    min_value: float32
    max_value: float32
}

LineChartProps :: struct {
    key: u64
    bounds: Rectangle
    semantic_label: string
    line_color: Color
    grid_color: Color
}

#program_export
ChartRangeFor :: (values: []float32) -> ChartRange {
    result: ChartRange
    if values.count == 0 { return result }
    result.low = values[0]
    result.high = values[0]
    index: s32 = 1
    while index < cast(s32)values.count {
        if values[index] < result.low { result.low = values[index] }
        if values[index] > result.high { result.high = values[index] }
        index += 1
    }
    spread: float32 = result.high - result.low
    if spread < 1.0 { spread = 1.0 }
    padding: float32 = spread * 0.10
    result.min_value = result.low - padding
    result.max_value = result.high + padding
    return result
}

#program_export
LineChart :: (session: Session, props: LineChartProps,
    values: []float32, chart_range: ChartRange) {
    background: PlotProps
    background.key = props.key
    background.mode = cast(PlotMode)PlotLines
    background.bounds = props.bounds
    background.semantic_label = props.semantic_label
    Plot(session, background, values[0:0])
    if values.count == 0 { return }

    span: float32 = chart_range.max_value - chart_range.min_value
    if span <= 0.0 { return }
    grid_index: s32 = 0
    while grid_index < 5 {
        fraction: float32 = cast(float32)grid_index / 4.0
        y: float32 = props.bounds.y + props.bounds.height * fraction
        PaintLine(session, -1,
            Rectangle.{props.bounds.x, y, props.bounds.width, 0.0},
            props.grid_color)
        grid_index += 1
    }

    if values.count == 1 {
        y: float32 = props.bounds.y + props.bounds.height *
            (chart_range.max_value - values[0]) / span
        PaintLine(session, -1,
            Rectangle.{props.bounds.x, y, props.bounds.width, 0.0},
            props.line_color)
    } else {
        index: s32 = 1
        while index < cast(s32)values.count {
            x0: float32 = props.bounds.x + props.bounds.width *
                cast(float32)(index - 1) / cast(float32)(values.count - 1)
            x1: float32 = props.bounds.x + props.bounds.width *
                cast(float32)index / cast(float32)(values.count - 1)
            y0: float32 = props.bounds.y + props.bounds.height *
                (chart_range.max_value - values[index - 1]) / span
            y1: float32 = props.bounds.y + props.bounds.height *
                (chart_range.max_value - values[index]) / span
            PaintLine(session, -1,
                Rectangle.{x0, y0, x1 - x0, y1 - y0}, props.line_color)
            PaintLine(session, -1,
                Rectangle.{x0, y0 + 1.0, x1 - x0, y1 - y0},
                props.line_color)
            index += 1
        }
    }
    last_y: float32 = props.bounds.y + props.bounds.height *
        (chart_range.max_value - values[values.count - 1]) / span
    PaintRoundedFill(session, -1,
        Rectangle.{props.bounds.x + props.bounds.width - 4.0,
            last_y - 4.0, 8.0, 8.0}, 4.0, 12, props.line_color)
}
