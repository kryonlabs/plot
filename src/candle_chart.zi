ButtonWidget :: #import "kryon/button";
#import "kryon/drawing_props"
#import "kryon/geometry"
#import "kryon/paint_queue"
#import "kryon/session"
#import "plot_widget"
#import "plot_props"
ChartMath :: #import "std/math";

PriceBar :: struct {
    timestamp: s64
    open: float32
    high: float32
    low: float32
    close: float32
    volume: float32
}

PriceBar64 :: struct {
    timestamp: s64
    open: float64
    high: float64
    low: float64
    close: float64
    volume: float64
}

CandleRange :: struct {
    low: float32
    high: float32
    min_value: float32
    max_value: float32
    max_volume: float32
    logarithmic: bool
}

CandleProjection :: struct {
    low: float64
    high: float64
    span: float64
    max_volume: float64
    range: CandleRange
}

CandleViewport :: struct {
    first: s32
    end: s32
    selected: s32
    right_edge: s64
}

CandleChartProps :: struct {
    key: u64
    bounds: Rectangle
    visible_count: s32
    semantic_label: string
    up_color: Color
    down_color: Color
    grid_color: Color
    sma20_color: Color
    sma50_color: Color
    ema20_color: Color
    show_sma20: bool
    show_sma50: bool
    show_ema20: bool
}

// Generic time markers. The chart caller owns the meaning of each marker.
ChartMarker :: struct {
    timestamp: s64
    label: string
    color: Color
}

// Generic horizontal price levels. Callers own the meaning and formatting of
// the level (entry, liquidation, alert, and so on).
ChartPriceLevel :: struct {
    value: float32
    label: string
    color: Color
}

#program_export
CandleVisibleStart :: (count: s32, visible_count: s32) -> s32 {
    if visible_count <= 0 || count <= visible_count { return 0 }
    return count - visible_count
}

// A rightward drag reveals older candles; a leftward drag moves toward now.
// The caller applies the returned candle count to its own time window.
#program_export
CandlePanStepsFor :: (start_x: float32, current_x: float32,
    bounds: Rectangle, visible_count: s32) -> s32 {
    if bounds.width <= 0.0 || visible_count <= 0 { return 0 }
    step: float32 = bounds.width / cast(float32)visible_count
    return cast(s32)((start_x - current_x) / step)
}

#program_export
CandleIndexAtX :: (x: float32, bounds: Rectangle,
    visible_count: s32) -> s32 {
    if visible_count <= 0 || bounds.width <= 0.0 ||
        x < bounds.x || x >= bounds.x + bounds.width { return -1 }
    return cast(s32)((x - bounds.x) *
        cast(float32)visible_count / bounds.width)
}

// The center of a zero-based visible slot, or -1 for an invalid slot or width.
#program_export
CandleCenterX :: (index: s32, bounds: Rectangle,
    visible_count: s32) -> float32 {
    if index < 0 || index >= visible_count || bounds.width <= 0.0 { return -1.0 }
    step: float32 = bounds.width / cast(float32)visible_count
    return bounds.x + (cast(float32)index + 0.5) * step
}

// Project the caller's visible bars into the linear [1, 2] price domain.
// Input prices and volumes are finite and each bar has ordered OHLC values.
// An empty input, short output or unusable domain returns span zero.
#program_export
CandleProject :: (bars: []PriceBar64, output: []PriceBar) -> CandleProjection {
    if bars.count == 0 || output.count < bars.count { return .{} }
    low: float64 = bars[0].low
    high: float64 = bars[0].high
    max_volume: float64 = 0.0
    for bars {
        if it.low < low { low = it.low }
        if it.high > high { high = it.high }
        if it.volume > max_volume { max_volume = it.volume }
    }
    span: float64 = high - low
    if span == 0.0 {
        // Match the flat price buffer on either side of the original value.
        scale: float64 = low
        if scale < 0.0 { scale = -scale }
        span = scale * 0.002
        if span / 2.0 == 0.0 { span = 0.000000002 }
        low -= span / 2.0
        high = low + span
    }
    if !(span > 0.0) || !ChartMath.Finite64(low) ||
        !ChartMath.Finite64(high) || !ChartMath.Finite64(span) { return .{} }

    for index: 0..bars.count - 1 {
        bar := bars[index]
        output[index] = .{.timestamp = bar.timestamp,
            .open = cast(float32)(1.0 + (bar.open - low) / span),
            .high = cast(float32)(1.0 + (bar.high - low) / span),
            .low = cast(float32)(1.0 + (bar.low - low) / span),
            .close = cast(float32)(1.0 + (bar.close - low) / span),
            .volume = ifx max_volume > 0.0 then cast(float32)(bar.volume / max_volume) else 0.0}
    }
    return .{.low = low, .high = high, .span = span, .max_volume = max_volume,
        .range = .{.low = 1.0, .high = 2.0, .min_value = 0.975,
            .max_value = 2.025, .max_volume = ifx max_volume > 0.0 then 1.0 else 0.0}}
}

// Recover a price from a normalized value, including the chart's padded ticks.
#program_export
CandleProjectedPrice :: (projection: CandleProjection, value: float64) -> float64 {
    return projection.low + (value - 1.0) * projection.span
}

#program_export
CandleRangeFor :: (bars: []PriceBar, visible_count: s32,
    logarithmic: bool = false) -> CandleRange {
    result: CandleRange
    result.logarithmic = logarithmic
    if bars.count == 0 { return result }
    start: s32 = CandleVisibleStart(cast(s32)bars.count, visible_count)
    index: s32 = start
    while index < cast(s32)bars.count {
        if !CandleValidPrice(bars[index].low) ||
            !CandleValidPrice(bars[index].high) ||
            bars[index].high < bars[index].low { index += 1; continue }
        if result.low == 0.0 { result.low = bars[index].low }
        if bars[index].low < result.low { result.low = bars[index].low }
        if bars[index].high > result.high { result.high = bars[index].high }
        if bars[index].volume > result.max_volume {
            result.max_volume = bars[index].volume
        }
        index += 1
    }
    CandlePadRange(*result)
    return result
}

#program_export
CandleValidPrice :: (value: float32) -> bool {
    return value > 0.0 && ChartMath.Finite64(cast(float64)value)
}

// Range endpoints remain actual prices. Every painter and inverse operation
// uses the same domain; callers may expand endpoints before padding again.
#program_export
CandlePadRange :: (range: *CandleRange) {
    if !CandleValidPrice(range.low) || !CandleValidPrice(range.high) { return }
    if range.logarithmic {
        low := ChartMath.Log(cast(float64)range.low)
        high := ChartMath.Log(cast(float64)range.high)
        spread := high - low
        if spread <= 0.0 { spread = 0.001 }
        range.min_value = cast(float32)ChartMath.Exp(low - spread * 0.05)
        range.max_value = cast(float32)ChartMath.Exp(high + spread * 0.05)
        return
    }
    spread: float32 = range.high - range.low
    // Do not impose a unit-sized range: it makes low-priced instruments look
    // flat. A truly flat series receives small proportional breathing room.
    if spread <= 0.0 {
        scale: float32 = range.high
        if scale < 0.0 { scale = -scale }
        if scale < 0.000001 { scale = 0.000001 }
        spread = scale * 0.001
    }
    padding: float32 = spread * 0.05
    range.min_value = range.low - padding
    range.max_value = range.high + padding
}

#program_export
CandlePriceBounds :: (bounds: Rectangle) -> Rectangle {
    result: Rectangle = bounds
    result.height = bounds.height * 0.74
    return result
}

#program_export
CandleVolumeBounds :: (bounds: Rectangle) -> Rectangle {
    return Rectangle.{bounds.x, bounds.y + bounds.height * 0.79,
        bounds.width, bounds.height * 0.18}
}

#program_export
CandleY :: (value: float32, bounds: Rectangle, range: CandleRange) -> float32 {
    if range.logarithmic {
        if !CandleValidPrice(value) || !CandleValidPrice(range.min_value) ||
            !CandleValidPrice(range.max_value) { return -1.0 }
        low := ChartMath.Log(cast(float64)range.min_value)
        high := ChartMath.Log(cast(float64)range.max_value)
        if high <= low { return bounds.y + bounds.height / 2.0 }
        fraction := (high - ChartMath.Log(cast(float64)value)) / (high - low)
        if fraction < 0.0 { fraction = 0.0 }
        if fraction > 1.0 { fraction = 1.0 }
        return bounds.y + cast(float32)fraction * bounds.height
    }
    span: float32 = range.max_value - range.min_value
    if span <= 0.0 { return bounds.y + bounds.height / 2.0 }
    fraction: float32 = (range.max_value - value) / span
    if fraction < 0.0 { fraction = 0.0 }
    if fraction > 1.0 { fraction = 1.0 }
    return bounds.y + fraction * bounds.height
}

#program_export
CandlePriceAtY :: (y: float32, bounds: Rectangle,
    range: CandleRange) -> float32 {
    if bounds.height <= 0.0 { return 0.0 }
    fraction := (y - bounds.y) / bounds.height
    if fraction < 0.0 { fraction = 0.0 }
    if fraction > 1.0 { fraction = 1.0 }
    if range.logarithmic {
        if !CandleValidPrice(range.min_value) ||
            !CandleValidPrice(range.max_value) { return 0.0 }
        low := ChartMath.Log(cast(float64)range.min_value)
        high := ChartMath.Log(cast(float64)range.max_value)
        return cast(float32)ChartMath.Exp(high - cast(float64)fraction * (high - low))
    }
    return range.max_value - fraction * (range.max_value - range.min_value)
}

// Zero means follow the latest candle; otherwise the timestamp is a stable
// right edge even when a refresh inserts earlier or later records.
#program_export
CandleWindowEnd :: (bars: []PriceBar, timestamp: s64) -> s32 {
    end := cast(s32)bars.count
    if timestamp <= 0 { return end }
    while end > 0 && bars[end - 1].timestamp > timestamp { end -= 1 }
    return end
}

#program_export
CandlePanEnd :: (end: s32, steps: s32, count: s32, visible: s32) -> s32 {
    if count <= 0 { return 0 }
    result: s64 = cast(s64)end + cast(s64)steps
    minimum := visible
    if minimum < 0 { minimum = 0 }
    if minimum > count { minimum = count }
    if result < minimum { return minimum }
    if result > count { return count }
    return cast(s32)result
}

// Resolve ascending timestamps to a bounded window and an absolute selection.
// A zero right edge follows the latest data. Missing selection uses the last
// visible candle; an empty input has no selection and returns -1.
#program_export
CandleViewportFor :: (bars: []PriceBar64, right_edge: s64,
    selected: s64, visible: s32) -> CandleViewport {
    count: s32 = cast(s32)bars.count
    if count == 0 { return .{.selected = -1} }
    width := visible
    if width <= 0 { width = 1 }
    if width > count { width = count }
    end := count
    if right_edge > 0 {
        while end > width && bars[end - 1].timestamp > right_edge { end -= 1 }
    }
    first := end - width
    selection := end - 1
    for index: first..end - 1 {
        if bars[index].timestamp == selected { selection = index; break }
    }
    return .{.first = first, .end = end, .selected = selection,
        .right_edge = ifx end == count then 0 else bars[end - 1].timestamp}
}

#program_export
SMAAt :: (bars: []PriceBar, index: s32, period: s32) -> float32 {
    if period <= 0 || index < period - 1 ||
        index >= cast(s32)bars.count { return 0.0 }
    total: float32 = 0.0
    cursor: s32 = index - period + 1
    while cursor <= index {
        if !CandleValidPrice(bars[cursor].close) { return 0.0 }
        total += bars[cursor].close
        cursor += 1
    }
    return total / cast(float32)period
}

#program_export
EMAAt :: (bars: []PriceBar, index: s32, period: s32) -> float32 {
    if period <= 0 || index < period - 1 ||
        index >= cast(s32)bars.count { return 0.0 }
    value: float32 = SMAAt(bars, period - 1, period)
    alpha: float32 = 2.0 / cast(float32)(period + 1)
    cursor: s32 = period
    while cursor <= index {
        if !CandleValidPrice(bars[cursor].close) { return 0.0 }
        value = alpha * bars[cursor].close + (1.0 - alpha) * value
        cursor += 1
    }
    return value
}

DrawAverage :: (session: Session, props: CandleChartProps,
    bars: []PriceBar, range: CandleRange, period: s32,
    exponential: bool, color: Color) {
    price: Rectangle = CandlePriceBounds(props.bounds)
    start: s32 = CandleVisibleStart(cast(s32)bars.count,
        props.visible_count)
    count: s32 = cast(s32)bars.count - start
    if count <= 0 { return }
    previous: bool = false
    previous_x: float32 = 0.0
    previous_y: float32 = 0.0
    index: s32 = start
    while index < cast(s32)bars.count {
        value: float32 = SMAAt(bars, index, period)
        if exponential { value = EMAAt(bars, index, period) }
        if CandleValidPrice(value) {
            x: float32 = CandleCenterX(index - start, price, count)
            y: float32 = CandleY(value, price, range)
            if previous {
                PaintLine(session, -1,
                    Rectangle.{previous_x, previous_y,
                        x - previous_x, y - previous_y}, color)
            }
            previous_x = x
            previous_y = y
            previous = true
        } else { previous = false }
        index += 1
    }
}

#program_export
CandleChart :: (session: Session, props: CandleChartProps,
    bars: []PriceBar, range: CandleRange) {
    background: PlotProps
    background.key = props.key
    background.mode = cast(PlotMode)0
    background.bounds = props.bounds
    background.semantic_label = props.semantic_label
    empty: [1]float32
    Plot(session, background, empty[0:0])
    if bars.count == 0 { return }

    price: Rectangle = CandlePriceBounds(props.bounds)
    volume: Rectangle = CandleVolumeBounds(props.bounds)
    grid_index: s32 = 0
    while grid_index < 5 {
        fraction: float32 = cast(float32)grid_index / 4.0
        y: float32 = price.y + price.height * fraction
        PaintLine(session, -1,
            Rectangle.{price.x, y, price.width, 0.0}, props.grid_color)
        grid_index += 1
    }
    PaintLine(session, -1,
        Rectangle.{volume.x, volume.y - 5.0, volume.width, 0.0},
        props.grid_color)

    start: s32 = CandleVisibleStart(cast(s32)bars.count,
        props.visible_count)
    count: s32 = cast(s32)bars.count - start
    step: float32 = price.width / cast(float32)count
    body_width: float32 = step * 0.63
    if body_width < 2.0 { body_width = 2.0 }
    if body_width > 12.0 { body_width = 12.0 }
    index: s32 = start
    while index < cast(s32)bars.count {
        bar: PriceBar = bars[index]
        if !CandleValidPrice(bar.open) || !CandleValidPrice(bar.close) ||
            !CandleValidPrice(bar.high) || !CandleValidPrice(bar.low) {
            index += 1
            continue
        }
        x: float32 = CandleCenterX(index - start, price, count)
        color: Color = props.up_color
        if bar.close < bar.open { color = props.down_color }
        wick_high: float32 = CandleY(bar.high, price, range)
        wick_low: float32 = CandleY(bar.low, price, range)
        PaintLine(session, -1,
            Rectangle.{x, wick_high, 0.0, wick_low - wick_high}, color)
        open_y: float32 = CandleY(bar.open, price, range)
        close_y: float32 = CandleY(bar.close, price, range)
        top: float32 = open_y
        bottom: float32 = close_y
        if bottom < top {
            top = close_y
            bottom = open_y
        }
        body_height: float32 = bottom - top
        if body_height < 2.0 {
            top -= 1.0
            body_height = 2.0
        }
        PaintRoundedFill(session, -1,
            Rectangle.{x - body_width / 2.0, top,
                body_width, body_height}, 0.0, 0, color)
        if range.max_volume > 0.0 {
            volume_height: float32 = volume.height *
                bar.volume / range.max_volume
            PaintRoundedFill(session, -1,
                Rectangle.{x - body_width / 2.0,
                    volume.y + volume.height - volume_height,
                    body_width, volume_height}, 0.0, 0, color)
        }
        index += 1
    }
    if props.show_sma20 {
        DrawAverage(session, props, bars, range, 20, false,
            props.sma20_color)
    }
    if props.show_sma50 {
        DrawAverage(session, props, bars, range, 50, false,
            props.sma50_color)
    }
    if props.show_ema20 {
        DrawAverage(session, props, bars, range, 20, true,
            props.ema20_color)
    }
}

#program_export
CandleMarkerX :: (bars: []PriceBar, visible_count: s32,
    bounds: Rectangle, timestamp: s64) -> float32 {
    if bars.count == 0 { return -1.0 }
    start: s32 = CandleVisibleStart(cast(s32)bars.count, visible_count)
    count: s32 = cast(s32)bars.count - start
    if bars.count == 1 {
        if timestamp != bars[0].timestamp { return -1.0 }
        return CandleCenterX(0, bounds, 1)
    }
    index: s32 = start
    while index < cast(s32)bars.count {
        next: s64 = 0
        if index + 1 < cast(s32)bars.count {
            next = bars[index + 1].timestamp
        } else if index > 0 {
            next = bars[index].timestamp +
                (bars[index].timestamp - bars[index - 1].timestamp)
        }
        if timestamp >= bars[index].timestamp &&
            (next <= bars[index].timestamp || timestamp < next) {
            return CandleCenterX(index - start, bounds, count)
        }
        index += 1
    }
    return -1.0
}

// Draws caller-labelled horizontal levels and returns the activated level.
#program_export
CandlePriceLevels :: (session: Session, props: CandleChartProps,
    range: CandleRange, levels: []ChartPriceLevel) -> s32 {
    selected: s32 = -1
    price: Rectangle = CandlePriceBounds(props.bounds)
    index: s32 = 0
    while index < cast(s32)levels.count {
        value: float32 = levels[index].value
        if CandleValidPrice(value) && value >= range.min_value &&
            value <= range.max_value {
            y: float32 = CandleY(value, price, range)
            PaintLine(session, -1,
                Rectangle.{price.x, y, price.width, 0.0},
                levels[index].color)
            level: ButtonWidget.Props
            level.key = props.key + cast(u64)2000 + cast(u64)index
            level.bounds = Rectangle.{price.x + price.width - 116.0,
                y - 10.0, 112.0, 20.0}
            level.label = levels[index].label
            if ButtonWidget.Draw(session, level) != 0 { selected = index }
        }
        index += 1
    }
    return selected
}

// Returns the activated marker index, or -1. Markers are rendered after the
// candles so their hit targets stay independent of the price and news model.
#program_export
CandleMarkers :: (session: Session, props: CandleChartProps,
    bars: []PriceBar, markers: []ChartMarker) -> s32 {
    selected: s32 = -1
    price: Rectangle = CandlePriceBounds(props.bounds)
    index: s32 = 0
    while index < cast(s32)markers.count {
        x: float32 = CandleMarkerX(bars, props.visible_count,
            price, markers[index].timestamp)
        if x >= 0.0 {
            PaintLine(session, -1,
                Rectangle.{x, price.y + 22.0, 0.0, price.height - 22.0},
                markers[index].color)
            marker: ButtonWidget.Props
            marker.key = props.key + cast(u64)1000 + cast(u64)index
            marker.bounds = Rectangle.{x - 11.0, price.y + 2.0, 22.0, 20.0}
            marker.label = markers[index].label
            if ButtonWidget.Draw(session, marker) != 0 { selected = index }
        }
        index += 1
    }
    return selected
}
